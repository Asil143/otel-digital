VITE_APP_NAME="Otel Digital"
VITE_DEFAULT_HOTEL_ID="hotel_harbour_view"

# Left blank in dev: the Vite dev server proxies /api to the local AI server (see vite.config.ts).
# Set only if the AI server is hosted on a different origin than the frontend.
VITE_API_BASE_URL=

# Server-side only (see server/index.mjs) — never expose provider keys in Vite client env.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# PORT=8787
